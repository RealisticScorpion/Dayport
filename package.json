{
  "name": "dayport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chrome new tab page for dense navigation, useful widgets, and fewer open tabs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealisticScorpion/Dayport.git"
  },
  "bugs": {
    "url": "https://github.com/RealisticScorpion/Dayport/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "DAYPORT_E2E=1 wxt build",
    "test:e2e": "npm run build:e2e && playwright test",
    "check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
